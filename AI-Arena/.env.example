# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=meridianarena
MONGODB_COLLECTION_NAME=users

# Authentication: generate independent random values with at least 32 characters.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Required when users store encrypted service credentials.
CREDENTIAL_ENCRYPTION_KEY=

AGENT_REGISTRY_TEST_TIMEOUT_SECONDS=30
AGENT_REGISTRY_RUN_TIMEOUT_SECONDS=120
# Recommended in production, for example: services.ai.azure.com,api.azureml.ms
AGENT_REGISTRY_ALLOWED_HOST_SUFFIXES=

# Use explicit frontend origins in production, separated by commas.
CORS_ORIGINS=http://localhost:3000

# Optional bootstrap account. Keep disabled after initial provisioning.
SEED_DEFAULT_USER=false
DEFAULT_USER_NAME=
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=

# Keep false unless Python runs inside a dedicated locked-down sandbox.
ENABLE_UNSAFE_PYTHON_TOOL=false
# Keep false unless outbound network policy and tool credentials are isolated.
ENABLE_ADVANCED_WEB_TOOL=false

# Governed custom-agent tool runtime. Enable only after activating dependencies
# in this order: policies -> MCP server -> tools.
ENABLE_GOVERNED_TOOL_RUNTIME=false
ENABLE_NATIVE_MCP_SERVER=false

# MongoDB is the authoritative private MCP registry. Runtime calls connect
# directly to catalog-approved MCP hosts.
APP_ENV=development
# Temporary until product RBAC is introduced. "authenticated" lets any signed-in
# user manage the shared catalog; switch to "admin" when roles are provisioned.
CAPABILITY_MANAGEMENT_ACCESS=authenticated
MCP_MAX_REQUEST_BYTES=1048576
MCP_MAX_RESPONSE_BYTES=5242880
MCP_VALIDATION_MAX_AGE_SECONDS=900
MCP_SERVER_VALIDATION_TIMEOUT_SECONDS=30
MCP_MAX_DISCOVERED_TOOLS=500
MCP_MAX_CONNECTIONS_PER_USER=10
MCP_MAX_ACTIVE_TOOLS_PER_AGENT=30
# Optional lockdown mode. Leave empty to allow arbitrary public HTTPS MCP hosts;
# private/local DNS and IP destinations are always rejected.
MCP_ALLOWED_ENDPOINT_HOSTS=

# Remote MCP OAuth is discovered dynamically. Client ID Metadata Documents are
# preferred, Dynamic Client Registration is the fallback, and unsupported
# providers request their client credentials through the authenticated UI.

# Azure OpenAI defaults (users may provide encrypted per-user credentials).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
LLM_PROVIDER=ollama

# Optional local-provider runtime
OLLAMA_MODEL=llama3.1
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
OLLAMA_TIMEOUT_SECONDS=300
# Minimum cosine similarity for accepting an Ollama-generated web query.
WEB_SEARCH_QUERY_SIMILARITY_THRESHOLD=0.35

# Runtime memory
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION_NAME=agent_arena_memory

# Optional side-effect tools
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_SENDER_ADDRESS=
GRAPH_ACCESS_TOKEN=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_AUTHORITY=
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Optional research tools
WEB_SEARCH_PROVIDER=ddgs
SERPAPI_API_KEY=
AGENTQL_API_KEY=
DATA_COLLECTOR_OUTPUT_DIR=outputs/data_collector_visualizer

# Azure AI Foundry prebuilt agents
AZURE_AI_ENDPOINT=
COMPLIANCE_AGENT_ID=
ATS_AGENT_ID=
CALL_AUDIT_AGENT_ID=
DATA_INSIGHTS_AGENT_ID=
LEGAL_AGENT_ID=

# Azure Blob Storage
BLOB_CONNECTION_STRING=
CONTAINER_NAME=user-uploads
STORAGE_LIMIT_MB=500
